# Local Python environments
.venv/
venv/
.env/

# Python bytecode and generated package metadata
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Test, coverage, type-checker, and linter output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
/coverage.xml
